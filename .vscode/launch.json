{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API: Launch (Development)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder:TenantAppApi}/Api/bin/Debug/net9.0/TenantApi.dll",
            "args": [],
            "cwd": "${workspaceFolder:TenantAppApi}/Api",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "launchSettingsProfile": "http",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "API: Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
